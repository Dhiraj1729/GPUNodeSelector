{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "image",
    "replicas",
    "port",
    "gpu",
    "resources"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "count"
      ],
      "properties": {
        "product": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-zA-Z0-9]([-a-zA-Z0-9_.]*[a-zA-Z0-9])?$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^([0-9]+m|[0-9]+([.][0-9]{1,3})?)$"
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
